    replacement_infos {
      original_chunk {
        target_content: "// 2. API: Generate personalized Software Blueprint JSON for structural feedback\napp.post(\"/api/gemini/blueprint\", async (req: Request, res: Response): Promise<void> => {\n  try {\n    const { name, companyName, projectDescription, estimatedBudget, urgency } = req.body;\n\n    if (!projectDescription) {\n      res.status(400).json({ error: \"Falta a descri\303\247\303\243o do projeto para gerar o blueprint.\" });\n      return;\n    }\n\n    const prompt = `Gere uma proposta de arquitetura t\303\251cnica de software para o lead com as seguintes informa\303\247\303\265es:\nNome do Lead: ${name}\nEmpresa: ${companyName || \'N\303\243o fornecida\'}\nDescri\303\247\303\243o do projeto: ${projectDescription}\nOr\303\247amento estimado: ${estimatedBudget || \'Sob consulta\'}\nUrg\303\252ncia do projeto: ${urgency}\n\nA Spacevip Sistemas precisa propor uma solu\303\247\303\243o robusta e madura. Retorne as informa\303\247\303\265es estruturadas in JSON detalhando a melhor solu\303\247\303\243o personalizada.`;\n\n    const systemInstruction = `Voc\303\252 \303\251 o Arquiteto de Software Chefe da Spacevip Sistemas. Sua tarefa \303\251 desenhar as especifica\303\247\303\265es iniciais de um sistema e retornar em JSON.\nA resposta deve conter:\n- suggestedCategory: Nome limpo e claro do sistema (ex: ERP de Opera\303\247\303\265es Log\303\255sticas, Portal SaaS de Alugu\303\251is, CRM Integrado de Vendas).\n- modules: Array de exatamente 3 ou 4 m\303\263dulos chaves (ex: [\"M\303\263dulo de Rastreamento Real-time\", \"Dashboard Geral de Produtividade\", \"Gateway de Cobran\303\247a Automatizada\"]).\n- techStack: Array com principais tecnologias recomendadas com as justificativas (ex: [\"React + Tailwind para interface veloz\", \"Node.js (NestJS) para microsservi\303\247os escal\303\241veis\", \"PostgreSQL para dados complexos e transacionais\"]).\n- complexity: Uma string dizendo explicitamente \'Baixa\' ou \'M\303\251dia\' ou \'Alta\' ou \'Alt\303\255ssima\'.\n- roiEstimate: Estimativa textual realista de retorno sobre investimento ou melhora (ex: \"Economia estimada de 15 a 20 horas por funcion\303\241rio/m\303\252s atrav\303\251s de automa\303\247\303\265es de faturamento\").\n- detailedBlueprint: Um texto em markdown descrevendo a vis\303\243o arquitetural para convencer o cliente de que o desenvolvimento sob medida com a Spacevip Sistemas \303\251 robustamente superior a qualquer software pronto.`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        systemInstruction,\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            suggestedCategory: { type: Type.STRING, description: \"Categoria do sistema personalizado sugerido.\" },\n            modules: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"M\303\263dulos de software principais sugeridos.\"\n            },\n            techStack: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"Principais tecnologias recomendadas para o projeto.\"\n            },\n            complexity: { type: Type.STRING, description: \"N\303\255vel de complexidade tecnol\303\263gica (Baixa, M\303\251dia, Alta, Alt\303\255ssima).\" },\n            roiEstimate: { type: Type.STRING, description: \"Estudo textual de ROI/Impacto Comercial estimado.\" },\n            detailedBlueprint: { type: Type.STRING, description: \"An\303\241lise profunda t\303\251cnica em Markdown de como o projeto ser\303\241 erguido pela Spacevip.\" }\n          },\n          required: [\"suggestedCategory\", \"modules\", \"techStack\", \"complexity\", \"roiEstimate\", \"detailedBlueprint\"]\n        }\n      }\n    });\n\n    const blueprintJson = JSON.parse(response.text || \"{}\");\n    res.json(blueprintJson);\n  } catch (error: any) {\n    console.error(\"Erro na gera\303\247\303\243o do Blueprint de Software:\", error);\n    res.status(500).json({ error: error.message || \"Falha t\303\251cnica ao estruturar proposta inteligente.\" });\n  }\n});\n\n// Configure Vite middleware and static serving\nasync function setupServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    console.log(\"Iniciando Vite em modo desenvolvimento...\");\n    const vite = await createViteServer({"
