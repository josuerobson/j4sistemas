        replacement_content: "            {/* Column 3 - Fast navigation links */}\n            <div className=\"md:col-span-3 space-y-4\">\n              <h4 className=\"text-xs font-bold uppercase tracking-wider text-cyan-400\">Atalhos</h4>\n              <div className=\"grid grid-cols-2 gap-2 text-xs font-semibold text-blue-200/80\">\n                <button onClick={() => window.scrollTo({ top: 0, behavior: \'smooth\' })} className=\"text-left hover:text-white transition\">In\303\255cio</button>\n                <button onClick={() => handleScrollTo(\"solucoes\")} className=\"text-left hover:text-white transition\">Solu\303\247\303\265es</button>\n                <button onClick={() => handleScrollTo(\"ia-consultor\")} className=\"text-left hover:text-white transition\">Conselhos IA</button>\n                <button onClick={() => handleScrollTo(\"como-funciona\")} className=\"text-left hover:text-white transition\">Processo</button>\n                <button onClick={() => handleScrollTo(\"depoimentos\")} className=\"text-left hover:text-white transition\">Depoimentos</button>\n                <button onClick={() => handleScrollTo(\"contato-modulo\")} className=\"text-left hover:text-white transition\">Diagn\303\263stico</button>\n                <button onClick={() => setIsAdminOpen(true)} className=\"text-left text-cyan-400 hover:text-white transition font-bold\">Painel Admin \342\206\227</button>\n              </div>\n            </div>\n\n          </div>\n\n          <div className=\"pt-8 flex flex-col md:flex-row justify-between items-center text-[10px] text-blue-300 gap-4\">\n            <p className=\"font-medium\">\n              &copy; {new Date().getFullYear()} Spacevip Sistemas Ltda. CNPJ sob consulta. Todos os direitos reservados.\n            </p>\n            <div className=\"flex gap-4 font-semibold\">\n              <span className=\"text-cyan-400\">Desenvolvido em alta performance</span>\n              <span>\342\200\242</span>\n              <span>Prote\303\247\303\243o LGPD ativa</span>\n            </div>\n          </div>\n\n        </div>\n      </footer>\n\n      {/* Modern Administrative Modal Overlay */}\n      <AnimatePresence>\n        {isAdminOpen && (\n          <AdminPanel onClose={() => setIsAdminOpen(false)} />\n        )}\n      </AnimatePresence>\n\n    </div>"
      }
