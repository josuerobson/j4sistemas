    replacement_chunks {
      replacement_content: "import { Service, Testimonial, ProcessStep } from \"./types\";\n\nexport const OFFICE_STATS = [\n  { value: \"140+\", label: \"Sistemas Entregues\" },\n  { value: \"4.9/5\", label: \"Avalia\303\247\303\243o M\303\251dia dos Clientes\" },\n  { value: \"+R$ 22M\", label: \"Retorno/Economia Gerada\" },\n  { value: \"100%\", label: \"Livre de Licen\303\247as por Usu\303\241rio\" },\n];\n\nexport const SERVICES: Service[] = [\n  {\n    id: \"erps-crms\",\n    title: \"ERPs & CRMs Inteligentes\",\n    description: \"Sistemas corporativos robustos desenhados exatamente para reproduzir e otimizar os fluxos reais do seu neg\303\263cio.\",\n    longDescription: \"Esque\303\247a softwares enlatados nos quais sua equipe precisa se adaptar. Criamos ERPs e CRMs constru\303\255dos em torno da sua metodologia. Automatize finan\303\247as, controle faturamento em lote, lidere CRM de vendas inteligente e obtenha relat\303\263rios anal\303\255ticos em tempo real.\",\n    icon: \"LayoutDashboard\",\n    benefits: [\n      \"Sem custo por usu\303\241rio: escala ilimitada para sua equipe.\",\n      \"Campos e relat\303\263rios customizados na sua linguagem.\",\n      \"Integra\303\247\303\243o nativa com meios de pagamento e notas fiscais.\"\n    ],\n    features: [\n      \"Gest\303\243o de Contratos e Cobran\303\247as recorrentes\",\n      \"Controle de Estoque e Compras inteligentes\",\n      \"M\303\263dulos integrados com permiss\303\265es refinadas de usu\303\241rios\",\n      \"Exporta\303\247\303\243o nativa em XLS, PDF e relat\303\263rios din\303\242micos\"\n    ]\n  },\n  {\n    id: \"automacoes-rpa\",\n    title: \"Automa\303\247\303\243o de Processos & RPA\",\n    description: \"Substitua tarefas repetitivas e planilhas inst\303\241veis por rob\303\264s estruturados e automa\303\247\303\265es de fluxos de trabalho.\",\n    longDescription: \"Elimine o retrabalho manual. Desenvolvemos automa\303\247\303\265es seguras que leem e-mails, processam documentos recebidos, disparam alertas inteligentes no WhatsApp de clientes e preenchem dados fiscais com precis\303\243o milim\303\251trica.\",\n    icon: \"Cpu\",\n    benefits: [\n      \"Redu\303\247\303\243o dr\303\241stica de erros humanos operacionais.\",\n      \"Libera\303\247\303\243o de pessoal qualificado para tarefas estrat\303\251gicas.\",\n      \"Sistemas trabalhando 24h por dia, 7 dias por semana.\"\n    ],\n    features: [\n      \"Integra\303\247\303\243o autom\303\241tica com APIs p\303\272blicas e sistemas legados\",\n      \"Processamento de OCR para leitura inteligente de documentos\",\n      \"Formatador de relat\303\263rios e faturas consolidadas automaticamente\",\n      \"Painel de logs centralizado de atividades automatizadas\"\n    ]\n  },\n  {\n    id: \"portais-saas\",\n    title: \"Portais Web & Plataformas SaaS\",\n    description: \"Aplica\303\247\303\265es web modernas, portais de clientes integrados ou produtos digitais prontos para comercializa\303\247\303\243o (SaaS).\",\n    longDescription: \"Erguemos plataformas escal\303\241veis na nuvem perfeitas para atuar como portais de autoatendimento de clientes ou novas ideias de startups. Criadas com interfaces fluidas de alt\303\255ssima performance para garantir engajamento total.\",\n    icon: \"Globe\",\n    benefits: [\n      \"Carregamento em milissegundos e prontos para SEO.\",\n      \"Painel espec\303\255fico e amig\303\241vel para cliente final.\",\n      \"Arquiteturas prontas para escala em milhares de sess\303\265es.\"\n    ],\n    features: [\n      \"Login seguro nativo ou integra\303\247\303\243o com redes sociais\",\n      \"M\303\272ltiplos n\303\255veis de assinatura e pagamento integrado\",\n      \"Chatbot interno para r\303\241pido autoatendimento de suporte\",\n      \"Configura\303\247\303\243o de marca branca (White-label) opcional\"\n    ]\n  },\n  {\n    id: \"integracoes-apis\",\n    title: \"Integra\303\247\303\243o Completa de APIs\",\n    description: \"Conecte seus sistemas atuais com servi\303\247os de entrega, bancos, marketplaces e CRMs do mercado sem fric\303\247\303\243o.\",\n    longDescription: \"N\303\243o jogue fora o que j\303\241 funciona. Conectamos seu banco de dados atual com APIs complexas como Stripe, WhatsApp Business, Salesforce, SAP, correios, meios de cobran\303\247a Pix e cart\303\265es de maneira extremamente veloz e segura.\",\n    icon: \"Shuffle\",\n    benefits: [\n      \"Fim do isolamento de dados entre ferramentas antigas.\",\n      \"Fluxo em tempo real sem atrasos manuais de fechamento.\",\n      \"Camada de barramento robusta que resiste a quedas de conex\303\243o.\"\n    ],\n    features: [\n      \"Desenvolvimento de webhooks de alta confiabilidade\",\n      \"Sincroniza\303\247\303\243o bidirecional de estoques e cadastros\",\n      \"Camada middleware protetora e anti-fraude\",\n      \"Notifica\303\247\303\265es instant\303\242neas de falhas para sua equipe t\303\251cnica\"\n    ]\n  }\n];\n\nexport const TESTIMONIALS: Testimonial[] = [\n  {\n    id: \"dep-1\",\n    name: \"Alexandre Gouveia\",\n    role: \"Diretor de Opera\303\247\303\265es\",\n    company: \"Logical Log\303\255stica Brasil\",\n    content: \"A Spacevip Sistemas substituiu um ERP gen\303\251rico que nos custava fortunas por um sistema focado puramente nas nossas entregas. Em 3 meses, reduzimos as falhas de faturamento a zero e o suporte ao cliente acelerou assustadoramente.\",\n    avatarSeed: \"alexandre\",\n    metrics: {\n      label: \"Crescimento Operacional\",\n      value: \"+45%\"\n    }\n  },\n  {\n    id: \"dep-2\",\n    name: \"Carolina Vasconcellos\",\n    role: \"S\303\263cia-Fundadora\",\n    company: \"Vasco & Associados Finan\303\247as\",\n    content: \"O sistema de gera\303\247\303\243o autom\303\241tica de propostas e controle de contratos sob medida revolucionou nossa rotina escritur\303\241ria. O dashboard gerencial deles d\303\241 clareza total de faturamento em tempo real.\",\n    avatarSeed: \"carolina\",\n    metrics: {\n      label: \"Tempo Economizado\",\n      value: \"18h/semana\"\n    }\n  },\n  {\n    id: \"dep-3\",\n    name: \"Ricardo Mendon\303\247a\",\n    role: \"CEO & Co-fundador\",\n    company: \"SaaSify Solu\303\247\303\265es\",\n    content: \"Entregar o desenvolvimento de nossa nova plataforma web para a Spacevip nos permitiu ir ao mercado 2 meses antes do previsto. O c\303\263digo \303\251 limpo, seguro e o design superou todas as expectativas da nossa equipe.\",\n    avatarSeed: \"ricardo\",\n    metrics: {\n      label: \"Faturamento Adicional\",\n      value: \"+R$120k/m\303\252s\"\n    }\n  }\n];\n\nexport const PROCESS_STEPS: ProcessStep[] = [\n  {\n    step: 1,\n    title: \"Diagn\303\263stico & Discovery\",\n    description: \"Estudamos minunciosamente seus gargalos di\303\241rios e as planilhas que geram fric\303\247\303\243o.\",\n    duration: \"Semana 1\",\n    details: [\n      \"Mapeamento detalhado dos processos manuais\",\n      \"An\303\241lise das integra\303\247\303\265es com APIs necess\303\241rias\",\n      \"Escopo t\303\251cnico visual e claro\"\n    ]\n  },\n  {\n    step: 2,\n    title: \"Arquitetura & Prototipagem\",\n    description: \"Desenhamos as primeiras telas e toda a infraestrutura com foco m\303\241ximo em usabilidade.\",\n    duration: \"Semanas 2 a 3\",\n    details: [\n      \"Prot\303\263tipos naveg\303\241veis detalhados de alta fidelidade\",\n      \"Defini\303\247\303\243o segura de banco de dados e fluxos de telas\",\n      \"Valida\303\247\303\243o total com o cliente antes de codificar\"\n    ]\n  },\n  {\n    step: 3,\n    title: \"Desenvolvimento \303\201gil\",\n    description: \"Nossa equipe codifica o sistema e realiza testes cont\303\255nuos automatizados.\",\n    duration: \"Semanas 4 a 8\",\n    details: [\n      \"Entregas incrementais com feedbacks constantes\",\n      \"Foco total em seguran\303\247a e velocidade de carregamento\",\n      \"C\303\263digo limpo, de alta performance e bem documentado\"\n    ]\n  },\n  {\n    step: 4,\n    title: \"Implanta\303\247\303\243o & Suporte\",\n    description: \"Colocamos o sistema no ar de forma transparente e treinamos seu time sem impacto na opera\303\247\303\243o.\",\n    duration: \"Cont\303\255nuo\",\n    details: [\n      \"Hospedagem em nuvens de alta performance autoescal\303\241vel\",\n      \"Suporte preventivo cont\303\255nuo e monitoramento de logs\",\n      \"Liberdade total para solicitar novas evolu\303\247\303\265es\"\n    ]\n  }\n];\n\nexport const FAQS = [\n  {\n    question: \"Quanto custa um sistema personalizado na Spacevip?\",\n    answer: \"Os projetos s\303\243o sob medida, ou seja, o investimento varia de acordo com os m\303\263dulos exigidos e as integra\303\247\303\265es necess\303\241rias. Oferecemos um diagn\303\263stico gratuito inicial para desenhar o escopo e entregar uma proposta de pre\303\247o fixo transparente.\"\n  },\n  {\n    question: \"Eu terei que pagar licen\303\247as mensais por usu\303\241rio?\",\n    answer: \"N\303\243o! Esse \303\251 um dos principais benef\303\255cios da Spacevip Sistemas. O c\303\263digo desenvolvido \303\251 seu. Voc\303\252 pode escalar sua equipe para 10, 100 ou 1000 usu\303\241rios sem pagar nenhum centavo adicional por licen\303\247a de uso individual.\"\n  },\n  {\n    question: \"O c\303\263digo do sistema pertence a quem?\",\n    answer: \"O c\303\263digo-fonte completo pertence 100% \303\240 sua empresa ap\303\263s a quita\303\247\303\243o do projeto. Voc\303\252 tem total independ\303\252ncia e liberdade jur\303\255dica.\"\n  },\n  {\n    question: \"Quem cuidar\303\241 do servidor e da manuten\303\247\303\243o do sistema?\",\n    answer: \"N\303\263s oferecemos planos completos de gerenciamento e suporte cont\303\255nuo na nuvem, garantindo backups, atualiza\303\247\303\265es de seguran\303\247a e monitoramento de desempenho. Caso queira, tamb\303\251m podemos configurar para rodar na nuvem pr\303\263pria de sua organiza\303\247\303\243o.\"\n  },\n  {\n    question: \"Qual o prazo m\303\251dio de entrega de um sistema?\",\n    answer: \"Sistemas em MVP ou com escopos focados costumam ir para o ar em cerca de 4 a 6 semanas. Projetos de ERPs extremamente robustos variam de 8 a 12 semanas, sempre com entregas parciais utiliz\303\241veis desde o primeiro m\303\252s.\"\n  }\n];\n"
    }
